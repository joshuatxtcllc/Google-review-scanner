# Google Places API — get one at https://console.cloud.google.com/
# Enable "Places API" (legacy) for this key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Random secret required as a Bearer token on /mcp and /api/scan/*.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change_me

# Set by Railway automatically; only needed for local dev
PORT=3000
